<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
<TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CMF BUDS" android:textColor="#FF5555" android:textSize="12sp" android:fontFamily="monospace" android:maxLines="2" android:ellipsize="end" />
<TextView android:id="@+id/widget_value" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="—" android:textColor="#FFFFFF" android:textSize="22sp" android:fontFamily="monospace" android:maxLines="2" android:ellipsize="end" />
